[Unit]
Description=Jarvis-AI Docker Compose backend
After=default.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/Projects/odysseus
ExecStart=@DOCKER_BIN@ compose up -d
ExecStop=@DOCKER_BIN@ compose down
TimeoutStartSec=15min
TimeoutStopSec=45

[Install]
WantedBy=default.target
